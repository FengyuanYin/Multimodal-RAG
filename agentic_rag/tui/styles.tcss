$primary: #7c6cff;
$secondary: #2dd4bf;
$accent: #a78bfa;
$background: #070b14;
$surface: #0e1626;
$text: #edf2ff;
$text-muted: #91a0ba;

Screen {
    layout: horizontal;
    background: $background;
    color: $text;
}

.workspace {
    width: 1fr;
    height: 100%;
    padding: 1 2;
}

.title {
    height: 3;
    text-style: bold;
    color: $text;
    padding: 0 1;
}

.toolbar, .form-row, .composer {
    height: auto;
    min-height: 3;
    margin-bottom: 1;
}

.toolbar Select { width: 24; margin-right: 1; }
.toolbar Input { width: 20; margin-right: 1; }
.toolbar Button { margin-right: 1; }
.form-row Input { width: 1fr; margin-right: 1; }
.form-row Select { width: 22; margin-right: 1; }
.form-row Button { margin-right: 1; }

.body-row { height: 1fr; }
#chat-sidebar {
    width: 28;
    height: 100%;
    border: round $primary-darken-2;
    background: $surface;
    margin-right: 1;
    padding: 0 1;
}
#conversations { height: 1fr; }
#memories { height: 10; }
#memory-input { margin-top: 1; }
.compact-actions { height: 3; }
.compact-actions Button { width: 1fr; min-width: 8; }
#chat-sources {
    height: auto;
    max-height: 8;
    padding: 0 2;
    color: $text-muted;
}
#chat-main {
    width: 1fr;
    height: 100%;
    border: round $primary-darken-2;
    background: $surface;
}
#chat-status, #knowledge-status, #evaluation-status, #settings-status {
    height: auto;
    min-height: 1;
    padding: 0 1;
    color: $text-muted;
}
.composer { height: 4; padding: 0 1; }
.composer Input { width: 1fr; margin-right: 1; }
.composer Button { width: 12; }

.section-title {
    text-style: bold;
    color: $accent;
    margin-top: 1;
    margin-bottom: 1;
}

.knowledge-actions {
    height: 20;
    border: round $primary-darken-2;
    background: $surface;
    padding: 0 1;
    margin-bottom: 1;
}

#documents, #evaluation-results {
    height: 1fr;
    border: round $primary-darken-2;
    background: $surface;
}

.settings-form, .help-content {
    height: 1fr;
    width: 100%;
    max-width: 110;
    border: round $primary-darken-2;
    background: $surface;
    padding: 1 2;
}

.settings-form Input, .settings-form Select {
    width: 100%;
    margin-bottom: 1;
}

Button:focus, Input:focus, Select:focus, DataTable:focus, ListView:focus {
    border: tall $accent;
}
