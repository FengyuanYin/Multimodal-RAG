# Agentic GraphRAG 系统配置
# 复制此文件为 .env 并填入实际值

# ── LLM 配置 ──
AGR_LLM_API_KEY=sk-your-api-key-here
AGR_LLM_MODEL=gpt-4o
AGR_LLM_BASE_URL=

# ── VLM 配置（多模态检索：图片/表格引用与问答） ──
AGR_VLM_PROVIDER=openai
AGR_VLM_MODEL=gpt-4o-mini
AGR_VLM_API_KEY=
AGR_VLM_BASE_URL=

# ── 多模态检索 ──
AGR_ENABLE_MULTIMODAL_RETRIEVAL=true
AGR_MEDIA_STORE_PATH=./data/media/media_registry.json
AGR_MEDIA_MAX_MEMORY_MB=512

# ── 嵌入模型 ──
AGR_EMBEDDING_MODEL=BAAI/bge-m3
AGR_EMBEDDING_DEVICE=cpu

# ── 重排序模型 ──
AGR_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
AGR_RERANKER_DEVICE=cpu

# ── 向量数据库 ──
AGR_VECTOR_DB_TYPE=milvus
AGR_MILVUS_URI=http://localhost:19530
AGR_MILVUS_DATABASE=default
AGR_MILVUS_COLLECTION=agentic_rag_vectors
AGR_MILVUS_TOKEN=

# ── 图数据库 ──
AGR_GRAPH_DB_TYPE=networkx
# AGR_NEO4J_URI=bolt://localhost:7687
# AGR_NEO4J_USER=neo4j
# AGR_NEO4J_PASSWORD=password

# ── API ──
AGR_API_HOST=0.0.0.0
AGR_API_PORT=8000
AGR_API_KEY=

# ── 检索参数 ──
AGR_TOP_K_INITIAL=20
AGR_TOP_K_RERANK=5
AGR_CHUNK_SIZE=512
AGR_CHUNK_OVERLAP=128

# ── 路由 ──
AGR_ROUTER_CONFIDENCE_THRESHOLD=0.6
AGR_ENABLE_FALLBACK=true

# ── 日志 ──
AGR_LOG_LEVEL=INFO
AGR_LOG_FILE=./data/logs/app.log
